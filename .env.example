# ── AI model (free, no Google account needed) ───────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint works.
# Default: Ollama running locally (https://ollama.com) — 100% free, runs on your machine.
#   1. Install Ollama   2. Run: ollama pull llama3.2
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="llama3.2"
# Only needed for hosted providers (Groq, OpenRouter, etc). Leave empty for Ollama / LM Studio.
LLM_API_KEY=""
# Twilio waits ~15s for a webhook reply; keep this below that.
LLM_TIMEOUT_MS="12000"

# ── Server ──────────────────────────────────────────────────────────────────
PORT="3000"

# ── Twilio voice (optional) ─────────────────────────────────────────────────
# Voice used for <Say> on phone calls.
TWILIO_VOICE="Polly.Joanna"
# If set, callers who ask for a human are transferred to this number.
HUMAN_FORWARD_NUMBER=""
